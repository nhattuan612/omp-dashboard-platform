#!/bin/zsh

if [[ "$1" == "--list-models" ]]; then
  print 'provider model context max-out thinking images'
  print 'google-antigravity gemini-3.8-flash 1000000 65536 yes yes'
  exit 0
fi

OMP_CA_BUNDLE="${OMP_CA_BUNDLE:-${HOME}/.omp/usage-dashboard/ca-bundle.pem}"
if [[ -f "$OMP_CA_BUNDLE" ]]; then
  export NODE_EXTRA_CA_CERTS="$OMP_CA_BUNDLE"
fi

if (( $+commands[omp] )); then
  exec omp "$@"
fi

exec "${HOME}/.bun/bin/omp" "$@"
