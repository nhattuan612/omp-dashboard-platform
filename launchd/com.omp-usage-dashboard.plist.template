<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omp-usage-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/.omp/usage-dashboard/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.omp/usage-dashboard</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.omp/usage-dashboard/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.omp/usage-dashboard/launchd.error.log</string>
</dict>
</plist>
